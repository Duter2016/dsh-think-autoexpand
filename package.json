{
  "name": "dsh-think-autoexpand",
  "version": "0.2.0",
  "description": "Keep Think reasoning rows visible and auto-expanded, and align the agent thinking language with the DeepSeek Harness UI language. 保持 Think 思考行可见并自动展开，让思考语言与 Harness 界面语言一致。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-settings": "*"
  }
}
